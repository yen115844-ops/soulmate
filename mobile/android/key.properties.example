# Copy to key.properties (same folder) and fill in. Never commit key.properties or keystore files.
#
# Create an upload keystore (one-time):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is relative to android/app/ (this module). Example: put upload-keystore.jks in android/app/
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
